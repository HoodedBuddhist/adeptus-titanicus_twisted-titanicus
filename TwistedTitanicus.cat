  <selectionEntries>
    <selectionEntry id="tt26-heavy-mandatum" name="Heavy Mandatum Battleline Maniple" publicationId="tt26-retr-2026-pub" page="" hidden="false" collective="false" import="false" type="unit">
      <rules>
        <rule id="tt26-pack-master" name="Pack Master" publicationId="tt26-retr-2026-pub" page="" hidden="false">
          <description>As long as a Warmaster/Iconoclast Titan from this maniple is on the battlefield, Warhound Titans from this maniple add 2 to the result of any Command check made when issuing Orders. In addition, Warhound Titans from this maniple add +1 to Hit rolls for attacks made against targets within 12&quot; of a Warmaster/Iconoclast Titan from this maniple.</description>
        </rule>
      </rules>
      <categoryLinks>
        <categoryLink id="tt26-heavy-mandatum-maniple" name="Maniple" hidden="false" targetId="6982-2d18-55cb-61e5" primary="true"/>
      </categoryLinks>
